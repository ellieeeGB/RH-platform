# Copiar como .env. Generar secretos con: python -c 'import secrets; print(secrets.token_hex(32))'
RH_SECRET=
RH_HMAC_SECRET=
RH_DATABASE_URL=sqlite:///privado/rh.db
RH_COOKIE_SECURE=0
RH_ORIGIN=http://127.0.0.1:8000
# En producción: HTTPS, COOKIE_SECURE=1 y origen exacto. No publicar el puerto sin proxy TLS.
