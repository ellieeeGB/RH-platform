# dependencies
/node_modules
/.pnp
.pnp.*

# next
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env
.env*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# raw / sensitive HR data
data/raw/*
