data/processed/*.private.json
data/processed/*.tmp.json

# python
__pycache__/
*.py[cod]
.venv/

# TypeScript incremental cache
*.tsbuildinfo

# Isolated pipeline stages and writer lock
data/.data-stage-*/
data/.data-pipeline.lock/
