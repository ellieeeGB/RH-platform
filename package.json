{
  "name": "rh-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:extract": "node --import tsx scripts/run-data-pipeline.ts",
    "data:verify": "node --import tsx scripts/verify-data.ts",
    "prebuild": "npm run data:verify",
    "predev": "npm run data:verify",
    "build:static": "node scripts/build-static.mjs",
    "prebuild:static": "npm run data:verify",
    "check:structure": "node scripts/check-project.mjs",
    "check": "npm run check:structure && npm run data:verify && npm run typecheck && npm test",
    "verify": "npm run check && npm run build:static"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "exceljs": "^4.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
